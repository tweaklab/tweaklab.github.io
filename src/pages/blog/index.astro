---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { visiblePosts } from '../../lib/posts';

const posts = visiblePosts(await getCollection('blog'));
---

<BaseLayout title="Blog" description="TweakLab에 작성한 글 목록">
  <section class="page-head shell">
    <h1>Blog</h1>
  </section>
  <section class="section shell">
    {posts.length > 0 ? (
      <div class="post-list">{posts.map((post) => <PostCard post={post} />)}</div>
    ) : (
      <p class="empty-state">아직 공개된 글이 없습니다.</p>
    )}
  </section>
</BaseLayout>
