---
import type { CollectionEntry } from 'astro:content';
import { formatDate, postPath } from '../lib/posts';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const hero = typeof post.data.heroImage === 'string' ? post.data.heroImage : post.data.heroImage.src;
---

<article class="post-card">
  <a class="card-thumbnail" href={postPath(post)} aria-label={`${post.data.title} 읽기`}>
    <img src={hero} alt="" width="320" height="180" loading="lazy" />
  </a>
  <div class="card-body">
    <div class="card-meta">
      <time datetime={post.data.publishedAt.toISOString()}>{formatDate(post.data.publishedAt)}</time>
      {post.data.tags.length > 0 && <span>{post.data.tags.join(' · ')}</span>}
    </div>
    <h2><a href={postPath(post)}>{post.data.title}</a></h2>
    <p>{post.data.description}</p>
  </div>
</article>
